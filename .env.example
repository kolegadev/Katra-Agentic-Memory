# ════════════════════════════════════════════════════════════════════
#  Katra — Configuration
#  Copy this file to .env and edit as needed
#
#  COMMON PITFALLS:
#  ✗ LLM_API_KEY   — does NOT exist. Use provider-specific names:
#  ✓ DEEPSEEK_API_KEY   (DeepSeek, recommended)
#  ✓ OPENAI_API_KEY     (OpenAI)
#  ✓ MOONSHOT_API_KEY   (Moonshot / Kimi)
#  ✓ OLLAMA_API_KEY     (Ollama, for local models — value doesn't matter)
# ════════════════════════════════════════════════════════════════════

# ── Contact ────────────────────────────────────────────────────────
# CONTACT_EMAIL: the maintainer contact address that install.sh
# substitutes into CODE_OF_CONDUCT.md (replacing its [CONTACT_EMAIL]
# placeholder). Every deployment sets its own — a real personal
# address must never ship in the repo.
#CONTACT_EMAIL=admin@example.com

# ── Data Storage ───────────────────────────────────────────────────
# Where all persistent data lives (MongoDB, Redis, MinIO).
# Default: ./data (relative to docker-compose.yml)
# USB:    /mnt/usb-secrets/katra (if USB stick mounted)
# Custom: any absolute path on the host
DATA_DIR=./data

# ── Network ────────────────────────────────────────────────────────
# Ports exposed to the host (for your agent to connect)
HOST_MCP_PORT=3112      # MCP endpoint — point your agent here
HOST_API_PORT=9012      # Admin REST API + Dashboard

# Internal ports (do not change)
MCP_PORT=3100

# ── MongoDB ────────────────────────────────────────────────────────
# REQUIRED. Left empty on purpose: docker compose refuses to start without
# MONGO_PASS rather than silently initialising your database with a known
# password. `./install.sh` generates these for you.
#
# ⚠ The password appears TWICE — as MONGO_PASS and inline in MONGODB_URI.
#   Both must match or the server cannot authenticate against its own database.
MONGO_USER=admin
MONGO_PASS=
MONGODB_URI=mongodb://admin:CHANGE_THIS_TO_MATCH_MONGO_PASS@mongo:27017/katra?authSource=admin&retryWrites=true&w=majority
DATABASE_NAME=katra

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── MinIO (S3-compatible storage for assets) ──────────────────────
# REQUIRED, and the two pairs must match:
#   MINIO_USER == AWS_ACCESS_KEY_ID
#   MINIO_PASS == AWS_SECRET_ACCESS_KEY
# MinIO is seeded with MINIO_USER/MINIO_PASS; the server authenticates with
# the AWS_* names. If they diverge, asset storage fails while everything else
# looks fine. `./install.sh` generates and syncs all four.
#
# MinIO requires a user of 3+ characters and a password of 8+ characters.
S3_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET_NAME=katra-assets
MINIO_USER=
MINIO_PASS=

# ── Authentication ────────────────────────────────────────────────
# KATRA_API_KEY: admin key for the REST API — also authenticates MCP
# calls as the trusted machine identity.
# MCP_API_KEY: legacy. Retired as an auth path after the identity
# cutover (2026-08-21): MCP calls authenticate with KATRA_API_KEY or
# a per-identity client key (system_settings.client_keys; keys for
# additional identities are generated at boot and printed once in the
# server log as "Client keys (identity separation)"). Kept only for
# first-boot seeding of the machine identity's client-key entry.
#
# If left unset, Katra will generate secure random keys on first startup,
# persist them in MongoDB (so they survive restarts), and print them in
# the server logs. You can then copy them into your agent's MCP config
# and watcher config.
#
# For production, set strong keys here instead of using generated ones.
# Leave the lines below commented to enable auto-generation on first boot.
#MCP_API_KEY=your-mcp-api-key-here
#KATRA_API_KEY=your-admin-api-key-here

# KATRA_USER_ID: the local (core) identity's user_id. All memory written by
# the trusted/loopback caller and the background processor lands under this
# identity. Defaults to 'katra'; set it to an existing identity's user_id
# when upgrading a pre-rename deployment (e.g. KATRA_USER_ID=satori) so the
# existing data stays attached to the same identity.
#KATRA_USER_ID=katra

# KATRA_EXTRA_IDENTITIES: additional per-identity client keys to provision
# at boot. Comma-separated `user_id:Display Name` pairs; each gets a freshly
# generated key printed once in the "Client keys (identity separation)"
# server-log block (only sha256 hashes are stored). Identities are
# deployment data — declare them here, never in code.
# Example: KATRA_EXTRA_IDENTITIES=agent-a:Agent A,agent-b:Agent B
#KATRA_EXTRA_IDENTITIES=

# ── Vault (encrypted secret store) ────────────────────────────────
# KATRA_VAULT_MASTER_KEY: master key for the Katra Vault secret store
# (AES-256-GCM envelope encryption). 32 random bytes as 64 hex chars —
# generate one with: openssl rand -hex 32
# `./install.sh` creates it automatically when absent; it NEVER overwrites
# an existing value, and it should never be rotated casually (every sealed
# secret depends on it). Leave commented to let install.sh generate it.
#KATRA_VAULT_MASTER_KEY=

# ── LLM Provider (for semantic extraction, auto-journaling, summaries) ──
#
# The LLM is used for: entity extraction, semantic fact distillation,
# auto-journaling, time-block summaries, and pattern detection.
#
# THREE WAYS TO CONFIGURE (pick one — no .env editing required):
#
# 1. MCP tool (agents self-configure during setup):
#    Call the `configure_llm` MCP tool with provider, api_key, base_url, model.
#    Example: configure_llm(provider="deepseek", api_key="sk-...", 
#              base_url="https://api.deepseek.com/v1", model="deepseek-v4-flash")
#
# 2. Dashboard UI:
#    Open http://localhost:9012/dashboard/ → Settings → LLM Configuration
#    Select provider, enter API key, click Save & Apply.
#
# 3. Environment variables (fallback — read on startup only):
#    Uncomment one of the blocks below. DB config (methods 1-2) overrides env.
#
# DeepSeek (recommended — affordable, high quality):
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash
#
# OpenAI:
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
#
# Moonshot (Kimi):
# MOONSHOT_API_KEY=sk-your-key-here
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=moonshot-v1-8k
#
# Ollama (local, no API key needed, runs on host):
# Recommended model: qwen2.5:3b (Qwen 2.5 3B Instruct, 32K context, GQA, tools).
# Pull with: ollama pull qwen2.5:3b
# GPU (Vulkan/CUDA) is auto-detected by Ollama if available.
# OLLAMA_API_KEY=ollama-no-key
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=qwen2.5:3b

# ── Embeddings ────────────────────────────────────────────────────
#
# Embeddings are ALWAYS local — no configuration needed.
#
# Katra uses Xenova/all-MiniLM-L6-v2 (22M params, 384 dimensions, ~80MB)
# via Transformers.js (ONNX runtime). The model downloads automatically
# on first memory storage and caches in the container.
#
# The Docker image uses node:20-slim (Debian/glibc) because the ONNX
# runtime requires glibc — it does NOT work on Alpine/musl.
#
# No API key. No external service. No cost. Works offline after first download.

# ── Multi-Tenancy (SaaS mode) ─────────────────────────────────────
# Set to true to enable database-per-tenant isolation
MULTI_TENANT=false

# ── Feature Flags ─────────────────────────────────────────────────
# PER_IDENTITY_PERSONALITY: give each identity its own saved Memory
# Personality instead of one process-wide record.
#
# OFF (default, and any value that is not 1/true/yes): resolution and writes
# use the legacy global record (system_settings.personality_config) exactly
# as before — nothing changes for an existing deployment.
# ON: resolution reads personality_config:<user_id>, falls back to the legacy
# global record, then to the built-in `balanced` defaults, and writes land on
# the caller's own identity record. Reads are caller-pinned; naming another
# identity (GET/PUT ?user_id=<id>) requires KATRA_API_KEY. The legacy record
# is never rewritten or deleted by the flag, so turning it off (or rolling
# back) restores the previous behaviour.
#
# Truthy values are 1, true or yes (case-insensitive). Anything else is off.
#PER_IDENTITY_PERSONALITY=1

# FOCUSED_IMAGINATION: mission-scoped focused consolidation + the private
# Salience Trace (ITER-5, Phase 3) and the imagination engine with its
# quality-diversity idea archive (ITER-6, Phase 4).
#
# OFF (default, and any value that is not 1/true/yes): all four tools
# (`run_focused_consolidation`, `get_salience_trace`, `generate_imagination_seeds`,
# `get_idea_archive`) are not registered at all — calling them returns
# "Unknown tool", nothing is written and no model call is made. An existing
# deployment sees no change.
# ON: a run gathers a mission's real state (mission state, active baton,
# epistemic ledger, open uncertainties, work queue, accepted deltas since the
# checkpoint, and the caller's reflection state as COUNTS ONLY) and makes ONE
# bounded LLM call (at most one retry) to produce an evidence-linked,
# calibrated Salience Trace in `salience_traces`, with its run ledger in
# `focused_consolidation_runs`. Both collections are personal kinds: written
# without a shared_id and never readable across identities. A repeat of the
# same {mission_id, cycle_id} replays the recorded run instead of calling the
# model again; a failed call is recorded as a failed run with no trace.
#
# With the same flag on, the imagination engine turns that trace into a
# portfolio of testable hypothesis seeds: the ten operator families are
# selected FROM the trace's own signals, one bounded LLM call is made per
# operator batch, a seeded multi-hop walk over the caller's knowledge graph
# supplies the bridges, and the seeds are admitted into a quality-diversity
# archive that rejects duplicates, paraphrases and excluded regions (with
# reasons): dedupe is containment-aware, so padding a restatement with extra
# characters does not smuggle it past the gate, and a ruled-out idea re-opens
# only with a VALID changed premise (a complete sentence that is not "nothing
# has changed" and that names content the excluded text did not) plus a lineage
# link to the prior rejection. Everything is deterministic given
# a seed (ids are derived, never random), so two runs with the same seed over
# the same inputs produce a byte-identical portfolio. `idea_seeds` and
# `idea_lineages` are personal kinds; `idea_archive_cells` is identity-owned
# and mission-indexed; the run ledger is `imagination_runs`. None of them can
# carry a shared_id, and the shareable surface (`get_idea_archive`) exposes
# bins, counts, quality and ids only — never a seed statement.
#
# Optional tuning (all have safe defaults, and a caller may ask for LESS than
# these caps but never for more):
#   FOCUSED_CONSOLIDATION_MAX_TOKENS  per-call token ceiling (default 2000)
#   FOCUSED_CONSOLIDATION_TIMEOUT_MS  hard per-attempt timeout (default 60000)
#   FOCUSED_IMAGINATION_MAX_SEEDS     seeds admitted per cycle (default 8)
#   FOCUSED_IMAGINATION_MAX_OPERATORS operator families per cycle (default 6)
#   FOCUSED_IMAGINATION_MAX_LLM_CALLS model calls per cycle, two operators
#                                     sharing one call (default 3)
#   FOCUSED_IMAGINATION_MAX_TOKENS    per-call token ceiling (default 3000)
#   FOCUSED_IMAGINATION_TIMEOUT_MS    hard per-attempt timeout (default 60000,
#                                     falling back to FOCUSED_CONSOLIDATION_TIMEOUT_MS)
#
# Truthy values are 1, true or yes (case-insensitive). Anything else is off.
#FOCUSED_IMAGINATION=1

# CREATIVE_BATON_PROMOTION: the gated promotion of a Creative Baton to the team
# scope (ITER-7, Phase 5). This flag does nothing on its own — it requires
# FOCUSED_IMAGINATION=1 as well, and the family flag alone exposes the cycle,
# the baton read, the controller adapter and the outcome feedback.
#
# OFF (default, and any value that is not 1/true/yes) with FOCUSED_IMAGINATION
# on: `promote_creative_baton` is not registered (calling it returns
# "Unknown tool"), the cycle still compiles a PRIVATE baton, and the promotion
# step is recorded as skipped (`flag_off`). No shared scope is ever written.
# ON (with FOCUSED_IMAGINATION=1): `promote_creative_baton` becomes available to
# a TRUSTED caller only. It re-validates the stored baton (JSON schema + secret
# scan + the payload hash the compiler wrote), so a tampered baton is refused
# with a named reason instead of being shared; on success it stamps
# `shared_id` (the team scope) and writes an audit row carrying the promoting
# identity, the timestamp, the schema version and the payload hash. Promoting
# the same payload twice is a no-op that reports the existing promotion.
#
# The cycle's own gates and budget (all have safe defaults):
#   IMAGINATION_CYCLE_COOLDOWN_MS            cooldown after a cycle (default
#                                            900000 = 15 min). It is PERSISTED
#                                            per mission, so a restart cannot
#                                            re-trigger early; shrinking the
#                                            window takes effect immediately.
#   IMAGINATION_CYCLE_WINDOW_MS              budget window (default 21600000 = 6 h)
#   IMAGINATION_CYCLE_MAX_PER_WINDOW         cycles per mission per window (default 3)
#   IMAGINATION_CYCLE_MAX_TOKENS_PER_WINDOW  measured tokens per window (default 20000)
#   IMAGINATION_PLATEAU_MIN_CANDIDATES       active-candidate floor (default 3)
#   IMAGINATION_PLATEAU_NOVELTY_EPSILON      novelty-gain epsilon (default 0.05)
#   IMAGINATION_PLATEAU_NOVELTY_ROUNDS       rounds the gain is measured over (default 2)
#   IMAGINATION_PLATEAU_COVERAGE_FLOOR       archive-cell floor (default 6)
#   IMAGINATION_PLATEAU_CONTRADICTION_THRESHOLD  live contradictions (default 2)
#   IMAGINATION_COVERAGE_TARGET              cells that stop the cycle (default 12)
#   IMAGINATION_CANDIDATE_FLOOR              novelty/coherence floor for a
#                                            candidate (default 0.35)
#   IMAGINATION_PROMOTION_MIN_QUALITY        "high-value" promotion (default 0.6)
#   IMAGINATION_MAX_BATON_CANDIDATES         candidates per baton (default 8)
#   IMAGINATION_MAX_ATTENTION_TARGETS        cues per baton (default 6)
#   IMAGINATION_MAX_EXCLUDED_REGIONS         fingerprints per baton (default 12)
#
# Truthy values are 1, true or yes (case-insensitive). Anything else is off.
#CREATIVE_BATON_PROMOTION=1

# IMAGINATION_BINS: the CONFIGURABLE descriptor space (ITER-11, WS-2 · brief §9
# "configurable diversity bins"). The five closed dimensions —
# mechanism, representation, violated_assumption, evidence_family,
# test_strategy — stay the DEFAULT and are used, byte for byte, when this
# variable is unset or empty. Setting it changes the space the archive files
# cells in, the coverage view reports and the baton compiler re-validates
# against.
#
# The value is JSON. Two forms are accepted:
#
#   plain (EXTEND/OVERRIDE the defaults; keys in config order, new keys appended)
#     IMAGINATION_BINS={"mechanism":["a","b"],"risk":["low","high"]}
#       → mechanism's bins become [a, b]; the other four defaults keep theirs;
#         `risk` is ADDED as a sixth dimension.
#
#   structured (REPLACE the default dimensions entirely)
#     IMAGINATION_BINS={"dimensions":{"mechanism":["a"],"risk":["low"]},"replace":true}
#
# Rules, all enforced at load and all FAIL-CLOSED:
#   - a non-JSON value, a non-object, a malformed or reserved dimension name
#     (`unclassified`, `dimensions`, `replace`), a name that resolves through
#     `Object.prototype` (`constructor`, `toString`, `__proto__` — refused as
#     `prototype_dimension` / `prototype_bin`, because a lookup for such a name
#     reads the prototype instead of the space), a bin list that is not an array
#     of lowercase slugs, an empty list, a duplicate bin, the reserved
#     `unclassified` bin, more than 64 bins per dimension, more than 16
#     dimensions and a config over 8192 characters are all REFUSED BY NAME;
#   - a refused config leaves the DEFAULT space in force — it never narrows the
#     space (which would strand stored cells) and never widens it (which would
#     let a marker into the shared coverage view);
#   - the refusal is visible: `GET /api/v1/imagination/rollout` reports
#     `descriptor_space.refused` (code + reason) and the active dimensions;
#   - a stored cell whose dimensions are not in the ACTIVE space is COUNTED
#     (`coverage.scan.cells_unknown_dimension`) and left out of the occupancy
#     maps instead of being folded into a lookalike dimension.
#
# See `docs/IMAGINATION-ROLLOUT.md` for the full reading and
# `server/src/services/processing/descriptor-space.ts` for the parser.
#IMAGINATION_BINS={"mechanism":["removal","composition"],"risk":["low","high"]}

# The §9 personality-learning decision (ITER-11, WS-5) is recorded ON the
# identity record (`personality_config:<user_id>` → `learning_policy` + `bounds`)
# whenever `PER_IDENTITY_PERSONALITY` is on. There is nothing to configure:
# learning is PROPOSAL-ONLY (one bounded step per dimension, at most one
# proposal per identity per week, applied by an operator through the ordinary
# PUT) and the hard invariants — the agent-message priority, the retrieval
# floors, the per-source caps and the privacy policy — can never be moved.

# COGNITIVE_TEAM_ALLOCATION: the cognitive team (ITER-8, Phase 6) — ephemeral,
# EXPIRING thinking modes on top of each identity's own disposition, bounded
# inheritance, §4.5 portfolio allocation, an independent first pass and a
# synthesis that preserves provenance.
#
# OFF (default, and any value that is not 1/true/yes): all six tools
# (`assign_thinking_mode`, `get_active_mode`, `create_inheritance_envelope`,
# `allocate_cognitive_portfolio`, `plan_independent_first_pass`,
# `synthesize_portfolios`) are not registered at all — calling them returns
# "Unknown tool", nothing is written and no model call is made. It is its own
# family flag: a deployment may run the single-agent imagination surface
# (FOCUSED_IMAGINATION) without ever assembling a team, and this flag does not
# change any other family's defaults.
# ON: a mission can hold a team of cognitive roles. A mode is an assignment
# with a REQUIRED reason (capped at 500 characters in the SERVICE, not only in
# the tool schema), a start and an explicit expiry — expiry is computed at read
# (no cron, no sweep) and recorded once behind a guard that pins the exact
# window the read computed from, so a read can never shorten a mode a renewal
# has just extended; an explicit `renew` is the only path that moves the window
# and an expired assignment cannot be renewed. A TTL must be a NUMBER of
# milliseconds inside the 1 minute..7 day window (a string is refused, never
# coerced), and a mode is only assigned or renewed on a mission that is still
# runnable — `completed`, `cancelled`, a draft or any other state is refused by
# name (`mission_not_runnable`) before anything is written.
# The catalogue is the brief's Appendix C verbatim (philosopher, technician,
# strategist, creative, analyst, critic, verifier, synthesizer) and each mode
# declares which APPROVED dimensions it may bias (k within ±25% of the parent's
# own value, vector_fetch_limit 1..20, cap_pct tightened within bounds) and
# never a hard invariant: the agent-message priority (10.0), the
# working-memory/vector floors, the per-source cap bounds and the privacy policy
# are refused BY NAME. An inheritance envelope is an immutable reference
# (parent identity + disposition snapshot + immutable bounds + approved
# dimensions + expiry) carrying NO private memory, and a bounded mutation
# produces a NEW derived envelope while the parent's own configuration stays
# byte-identical. Allocation builds a PORTFOLIO (not one winner) that covers the
# archive's missing bins, reports every score component with its inputs, and
# reserves one verifier/critic that is not among the generators ("independent
# evaluator"); its duplicate-pick convergence penalty is measured against the
# portfolio AS IT STANDS, so it decides the pick, and the portfolio id is
# derived from the candidate SET, so re-ordering the same candidates reuses the
# stored row. The first pass gives each agent its OWN request (mission digest +
# its own envelope/mode + public context) and each agent generates from its own
# trace and archive — no peer seeds, identities or private memory. Synthesis
# keeps per-candidate provenance and exclusion reasons verbatim and cannot
# promote; it cannot ADD an exclusion either — one supplied that is not on
# record is ignored and named back.
#
# Everything is written PRIVATELY: `thinking_mode_assignments`,
# `inheritance_envelopes` and `cognitive_portfolios` are personal kinds and can
# never carry a shared_id.
#
# Truthy values are 1, true or yes (case-insensitive). Anything else is off.
#COGNITIVE_TEAM_ALLOCATION=1

# ── Imagination observability (ITER-9, Phase 7) ────────────────────
# No new flag is introduced: the observability layer rides the four flags
# above. It adds a READ-ONLY operator surface at /api/v1/imagination
# (overview, cycles + cycle detail, traces, archive, batons, team, metrics,
# experiments, experiments/compare, rollout) plus two MCP tools behind
# FOCUSED_IMAGINATION:
#   get_imagination_metrics        — the §7.3 metric set, caller-pinned
#   record_experiment_observation  — the ONE write: trusted callers only, flag
#                                    on, caller-owned, closed shape, idempotent
#                                    per {experiment, arm, metric, checkpoint}
# No view runs a cycle, promotes a baton or changes a mode. Every metric carries
# its basis (window, n, source collections) and reports insufficient_data below
# its documented minimum instead of fabricating a rate — cost of novelty with a
# zero denominator is insufficient_data, not 0. Privacy leakage is reported as
# an audit count with its basis (the shared artefacts scanned, the markers
# checked), never as a constant. Every view states why it is empty (flag off,
# no data, plane off).
#
# The staged rollout, the metric gates per stage, the kill switches and the
# executable rollback commands live in docs/IMAGINATION-ROLLOUT.md. The
# dashboard's Rollout view derives the flag and kill-switch state from THIS
# environment, so it always reports what is actually on.
#
# Optional tuning:
#   IMAGINATION_METRICS_WINDOW_DAYS  the default measurement window for every
#                                    windowed metric (default 14 days). A
#                                    per-call `window_days` overrides it.
#IMAGINATION_METRICS_WINDOW_DAYS=14

# ── Server ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=9002
MCP_PORT_INTERNAL=3100
