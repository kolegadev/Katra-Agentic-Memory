{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://katra.dev/schemas/agent-cognitive-profile.schema.json",
  "title": "Katra Agent Cognitive Profile",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "agent_id",
    "profile_version",
    "work_class_metrics",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "agent_id": {
      "type": "string"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "disposition_features": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "domain_features": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "work_class_metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempts",
          "success_rate"
        ],
        "properties": {
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "success_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "average_cost": {
            "type": "number",
            "minimum": 0
          },
          "calibration_error": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "capability_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "current_workload": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "derived_from_private_memory": {
      "type": "boolean",
      "const": false
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
