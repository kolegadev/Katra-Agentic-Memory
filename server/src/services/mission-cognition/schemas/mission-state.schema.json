{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://katra.dev/schemas/mission-state.schema.json",
  "title": "Katra Mission State",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "mission_id",
    "version",
    "title",
    "intent",
    "status",
    "owner_id",
    "success_criteria",
    "authority_class",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "paused",
        "blocked",
        "completed",
        "cancelled",
        "integrity_hold"
      ]
    },
    "phase": {
      "type": "string",
      "maxLength": 120
    },
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "shared_id": {
      "type": "string"
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "authority_class": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "objectives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objective"
      }
    },
    "ledger_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "capability_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "active_baton_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "checkpoint_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_cognition": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "status": {
          "enum": [
            "unmet",
            "partial",
            "met",
            "waived"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "time",
            "cost",
            "privacy",
            "safety",
            "legal",
            "technical",
            "authority",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "status",
        "owner_id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "status": {
          "enum": [
            "pending",
            "ready",
            "in_progress",
            "blocked",
            "completed",
            "cancelled"
          ]
        },
        "owner_id": {
          "type": "string"
        },
        "dependency_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "uri",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "scope",
        "operations",
        "approval"
      ],
      "properties": {
        "capability_id": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "approval": {
          "enum": [
            "autonomous",
            "gated",
            "cautious"
          ]
        }
      }
    }
  }
}
