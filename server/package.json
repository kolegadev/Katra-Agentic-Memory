{
  "name": "katra-server",
  "version": "1.0.0",
  "description": "Katra \u2014 Cognitive Memory as a Service for AI Agents",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "start": "node --import dotenv/config build/index.js",
    "dev": "node --import dotenv/config build/index.js",
    "mcp:stdio": "node build/mcp-server.js --stdio",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:security": "vitest run tests/security/",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "mongodb": "^7.6.0",
    "openai": "^7.10.0",
    "redis": "^6.2.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "uuid": "^14.0.2",
    "web-tree-sitter": "^0.27.0",
    "zod": "^4.5.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "overrides": {
    "fast-uri": "^3.1.7",
    "qs": "^6.16.0",
    "ip-address": "^10.7.0",
    "postcss": "^8.5.28",
    "nanoid": "^3.3.18",
    "sharp": "^0.35.4",
    "protobufjs": "^7.6.6"
  }
}
